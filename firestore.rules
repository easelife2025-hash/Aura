rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'content', 'timestamp', 'ownerId']) &&
             data.keys().size() == 4 &&
             data.role is string && (data.role == 'user' || data.role == 'assistant') &&
             data.content is string && data.content.size() <= 100000 &&
             data.timestamp is number &&
             data.ownerId is string && data.ownerId == request.auth.uid;
    }
    
    function isValidTask(data) {
      return data.keys().hasAll(['title', 'status', 'createdAt']) &&
             data.keys().size() <= 3 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
             data.status is string && (data.status == 'pending' || data.status == 'completed') &&
             data.createdAt is number;
    }
    
    function isValidHabitCreate(data) {
       return data.keys().hasAll(['title', 'streak', 'createdAt']) &&
              data.keys().size() == 3 &&
              data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
              data.streak is number &&
              data.createdAt is number;
    }
    
    function isValidHabitUpdate(data) {
       return data.keys().hasAll(['title', 'streak', 'createdAt', 'lastCompleted']) &&
              data.keys().size() == 4 &&
              data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
              data.streak is number &&
              data.createdAt is number &&
              data.lastCompleted is number;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['smartReminders', 'pushNotifications', 'personalizedRecommendations', 'dailyInsights', 'personalityMode', 'theme']) &&
             data.smartReminders is bool &&
             data.pushNotifications is bool &&
             data.personalizedRecommendations is bool &&
             data.dailyInsights is bool &&
             data.personalityMode is string && (data.personalityMode == 'professional' || data.personalityMode == 'friendly' || data.personalityMode == 'concise' || data.personalityMode == 'creative') &&
             data.theme is string && (data.theme == 'system' || data.theme == 'dark' || data.theme == 'light' || data.theme == 'cosmic');
    }

    match /users/{userId} {
      match /messages/{messageId} {
        allow read, list: if isSignedIn() && userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidId(messageId) && isValidMessage(incoming());
        allow update, delete: if false;
      }

      match /tasks/{taskId} {
        allow read, list: if isSignedIn() && userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidId(taskId) && isValidTask(incoming());
        allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidId(taskId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                      isValidTask(incoming());
        allow delete: if isSignedIn() && userId == request.auth.uid && isValidId(userId) && isValidId(taskId);
      }

      match /habits/{habitId} {
        allow list, read: if isSignedIn() && userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidId(habitId) && isValidHabitCreate(incoming());
        allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidId(habitId) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['streak', 'lastCompleted']) &&
                      isValidHabitUpdate(incoming());
        allow delete: if isSignedIn() && userId == request.auth.uid && isValidId(userId) && isValidId(habitId);
      }
      
      match /settings/{settingId} {
        allow read, list: if isSignedIn() && userId == request.auth.uid;
        allow write: if isSignedIn() && userId == request.auth.uid && settingId == 'preferences' && isValidSettings(incoming());
      }
    }
  }
}
